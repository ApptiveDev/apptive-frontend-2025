generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Jobs {
  PM       @map("기획")
  DESIGN   @map("디자인")
  FRONTEND @map("프론트엔드")
  ANDROID  @map("안드로이드")
  BACKEND  @map("백엔드")
  GAME     @map("게임")
}

model History_Event {
  id       Int      @id @default(autoincrement())
  year     Int
  title    String
  createAt DateTime @default(now())
  updateAt DateTime @default(now())

  history_awards History_Awards[]
}

model History_Awards {
  id       Int      @id @default(autoincrement())
  event_id Int
  award    String
  createAt DateTime @default(now())
  updateAt DateTime @default(now())

  history_event History_Event @relation(fields: [event_id], references: [id])
}

model Study_Curriculum {
  id       Int      @id @default(autoincrement())
  class    Int // 기수
  term     Int // 학기
  job      Jobs
  order    Int
  content  String
  createAt DateTime @default(now())
}

